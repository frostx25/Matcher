# Use only a separate development Supabase project here.
# Never commit real values or reuse production credentials.
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public Firebase Android configuration copied to local.properties for builds.
# These identify the client app but never include a service-account private key.
FIREBASE_API_KEY=replace_with_android_client_api_key
FIREBASE_APPLICATION_ID=replace_with_android_app_id
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_SENDER_ID=replace_with_project_number

# DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WORKFLOW_VERSION,
# DIDIT_WEBHOOK_SECRET, FIREBASE_SERVICE_ACCOUNT_JSON,
# GOOGLE_CLOUD_VISION_API_KEY and WORKER_SHARED_SECRET are server-only.
# Never add them to this Android-facing file; use
# supabase/functions/.env.example as the server-side template.
