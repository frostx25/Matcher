# Use only a separate development Supabase project here.
# Never commit real values or reuse production credentials.
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WORKFLOW_VERSION,
# DIDIT_WEBHOOK_SECRET and DIDIT_ENVIRONMENT are server-only.
# Never add them to this Android-facing file; use
# supabase/functions/.env.example as the server-side template.
