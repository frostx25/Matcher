# Copy to .env.local in this directory. The local file is ignored by Git.
# Never place these values in local.properties, BuildConfig or the APK.
DIDIT_API_KEY=replace_with_server_secret
DIDIT_WORKFLOW_ID=replace_with_published_workflow_id
DIDIT_WORKFLOW_VERSION=replace_with_published_workflow_version
DIDIT_WEBHOOK_SECRET=replace_with_server_secret
DIDIT_ENVIRONMENT=sandbox
AGE_VERIFICATION_POLICY_VERSION=age-v2-didit-document

# Server-only workers. FIREBASE_SERVICE_ACCOUNT_JSON is the complete compact
# JSON value; never copy it, the Vision key or the worker secret into Android.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_me","private_key_id":"replace_me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n","client_email":"replace_me@replace_me.iam.gserviceaccount.com","client_id":"replace_me","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_CLOUD_VISION_API_KEY=replace_with_restricted_server_key
WORKER_SHARED_SECRET=replace_with_at_least_32_random_bytes

# DIDIT_ENVIRONMENT accepts only sandbox or live, exactly as returned by Didit.
# The API key, workflow
# and webhook secret must all belong to the same environment.
# DIDIT_API_BASE_URL=http://host.docker.internal:8787 # local contract tests only
