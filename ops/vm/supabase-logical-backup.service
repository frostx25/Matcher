[Unit]
Description=Create encrypted logical backup of VibeAli Supabase database
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/vibeali/supabase-logical-backup.sh
User=root
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/vibeali
ProtectHome=true
